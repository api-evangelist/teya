      "item": [
        {
          "id": "268d0590-02b0-4d0f-98b8-4f275365c7a0",
          "name": "Capture a pre-authorised transaction",
          "request": {
            "name": "Capture a pre-authorised transaction",
            "description": {
              "content": "API to capture a previously pre-authorised transaction.\n<br><br><strong>Usage notes:</strong>\n<ul>\n<li>The capture amount must be less than or equal to the original authorisation amount.</li>\n<li>Only one capture is allowed per pre-authorised transaction. Once captured (fully or partially), the transaction cannot be captured again.</li>\n</ul>\n<br><strong>Access Token Required scope:</strong> captures/create\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "transactions",
                ":id",
                "capture"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The transaction ID of the pre-authorisation to capture"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "A unique key to identify the request.\nIf the request is repeated with the same key, the same response will be returned.\nIf the request is repeated with a different key or without a key, a new capture will be created.\n",
                "key": "Idempotency-Key",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"<long>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
