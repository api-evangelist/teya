          "request": {
            "name": "Create a DCC offer",
            "description": {
              "content": "Verifies that the cardholder's card is eligible for DCC, fetches the latest exchange rate, creates a persisted quote, and returns an offer with a quote ID.\n\n**Required OAuth scopes:** `fx/dcc/create`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "fx",
                "v1",
                "dcc",
                "offers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
