                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_amount\": \"<long>\",\n  \"base_currency\": \"<string>\",\n  \"card_first9\": \"<string>\",\n  \"store_id\": \"<uuid>\",\n  \"cardholder_currency\": \"<string>\"\n}",
